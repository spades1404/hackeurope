# Copy this to .env and fill in your values

# LLM Provider: ollama | gemini | anthropic
LLM_PROVIDER=ollama

# Ollama self-hosted (via ngrok or local)
OLLAMA_BASE_URL=https://your-name.ngrok-free.app
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # If Ollama runs on same machine
OLLAMA_AUTH_USER=
OLLAMA_AUTH_PASS=
LLM_MODEL=ollama/gemma3:12b
LLM_VISION_MODEL=ollama/llama3.2-vision:11b

# Cloud providers (uncomment if using)
# GEMINI_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash

# Scheduler
SCHEDULER_INTERVAL=300
AUTO_GENERATE_DAYS=30
